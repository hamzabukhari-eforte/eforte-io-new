{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "WEB_PORT",
    "ADMIN_PORT",
    "API_PORT",
    "STRAPI_PORT",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_STRAPI_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
