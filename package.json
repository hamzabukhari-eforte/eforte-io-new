{
  "name": "eforte",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=@eforte/web",
    "dev:web": "turbo run dev --filter=@eforte/web",
    "build": "turbo run build --filter=@eforte/web",
    "lint": "turbo run lint --filter=@eforte/web",
    "start": "pnpm --filter @eforte/web start"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.21.0 <12.0.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
