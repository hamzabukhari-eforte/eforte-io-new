# Shared monorepo ports (source of truth)
# Note: Chrome blocks port 6000 (ERR_UNSAFE_PORT), so we start at 6100.
API_PORT=6100
WEB_PORT=6200
ADMIN_PORT=6300
STRAPI_PORT=6400

# Nest API → local Supabase Postgres (schema `api`)
# DB port 54332 avoids clash with other local Supabase projects (default 54322)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres?schema=api
CORS_ORIGIN=http://localhost:6200
